rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && isValidId(userId) &&
        incoming().uid == request.auth.uid;

      allow update: if (isOwner(userId) || isAdmin()) &&
        incoming().uid == existing().uid;

      allow delete: if isAdmin();

      // User Subcollections
      match /user_preferences/{prefId} {
        allow read, write: if isOwner(userId);
      }

      match /exam_information/{examId} {
        allow read, write: if isOwner(userId);
      }

      match /chapter_progress/{chapterId} {
        allow read, write: if isOwner(userId);
      }

      match /study_plan/{planId} {
        allow read, write: if isOwner(userId);
      }

      match /daily_targets/{targetId} {
        allow read, write: if isOwner(userId);
      }

      match /weekly_targets/{targetId} {
        allow read, write: if isOwner(userId);
      }

      match /study_statistics/{statId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Syllabus Templates (Board & Class Curriculums)
    match /syllabus_templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Allows seeding from authorized students or admins
    }

    // Study Materials Collection (Curated Content)
    match /studyMaterials/{materialId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Legacy Student Progress Collection
    match /progress/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isOwner(userId) && isValidId(userId) &&
        incoming().userId == request.auth.uid;

      allow update: if isOwner(userId) &&
        incoming().userId == existing().userId;

      allow delete: if isAdmin();
    }

    // Admin Verification collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
