rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email == 'devgamerz3131@gmail.com') ||
        request.auth.uid == 'devgamerz3131@gmail.com'
      );
    }

    // Users Collection & All Nested User Subcollections
    // Fully permit student and guest sync data across all subcollections
    match /users/{userId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Standalone Half-Yearly Collection
    match /half_yearly_analysis/{docId} {
      allow read, write: if true;
    }

    // Daily Missions Collection
    match /daily_missions/{docId} {
      allow read, write: if true;
    }

    // System Audit Collection
    match /system_audit/{auditId} {
      allow read, write: if true;
    }

    // Syllabus Templates
    match /syllabus_templates/{templateId} {
      allow read, write: if true;
    }

    // Study Materials Collection
    match /studyMaterials/{materialId} {
      allow read, write: if true;
    }

    // Student Progress Collection
    match /progress/{userId} {
      allow read, write: if true;
      match /{allProgress=**} {
        allow read, write: if true;
      }
    }

    // Admin Verification collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // App Config
    match /app_config/{configId} {
      allow read, write: if true;
    }

    // Universal catch-all for all application collections and nested documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
